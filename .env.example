# Copy to a private environment file outside the source tree; replace placeholders.
# DATABASE_URL is required for schedules/jobs/manifests; leave unset only for manual upload/conversion.
DATABASE_URL=postgresql+psycopg://frame_studio:REPLACE_PASSWORD@127.0.0.1:5432/frame_studio
EINK_ARTIFACT_ROOT=/var/lib/frame-studio/artifacts
EINK_FRONTEND_DIST=/opt/frame-studio/frontend/dist
EINK_FRAME_WORKER_TOKEN=REPLACE_WITH_RANDOM_SHARED_WORKER_TOKEN
EINK_FRAME_DEVICE_TOKEN=REPLACE_WITH_RANDOM_SHARED_DEVICE_TOKEN
EINK_LOCATION_LATITUDE=REPLACE_LATITUDE
EINK_LOCATION_LONGITUDE=REPLACE_LONGITUDE
EINK_LOCATION_NAME=REPLACE_LOCATION_NAME
EINK_TIMEZONE=Etc/UTC
EINK_PANEL_ROTATION=transverse
# Remote worker (on a GPU host, separately):
EINK_BACKEND_URL=http://REPLACE_PRIVATE_BACKEND_HOST:8787
EINK_COMFYUI_URL=http://127.0.0.1:8188
EINK_COMFYUI_CONTAINER=REPLACE_STOPPED_COMFY_CONTAINER_NAME
EINK_WORKER_ID=REPLACE_UNIQUE_WORKER_ID
EINK_COMFYUI_START_TIMEOUT=30
EINK_COMFYUI_READY_TIMEOUT=300
EINK_COMFYUI_STOP_TIMEOUT=30
